# Certify.cx — Environment Variables
# Copy this file to .env and fill in your values

# Supabase credentials (required)
VITE_SUPABASE_URL=https://jlzzessjfswplcieymki.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Impsenplc3NqZnN3cGxjaWV5bWtpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM1NzQ5NjMsImV4cCI6MjA4OTE1MDk2M30.sSSjDCrYRw0Ut-Tw84fcHFTwgkc3GdoGYR6y1O701cI

# Service role key — NEVER expose in frontend code
# Only use in server-side scripts or Supabase Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Geoapify API Key
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Resend transactional email (used by api/auth-email-hook.js + api/send-welcome.js)
RESEND_API_KEY=re_EToUS1Si_P3wLSMsU68cqqdpFhNswNtGc
RESEND_FROM_EMAIL=CertifyCX <noreply@mail.certify.cx>
# From-address for customer-facing lifecycle emails (payment, application,
# audit, certificate) sent by api/notify-event.js + api/issue-certificate.js.
# Must be a domain verified in Resend. Falls back to RESEND_FROM_EMAIL if unset.
RESEND_SUPPORT_FROM_EMAIL=Certify.cx Support <support@certify.cx>

# Supabase Send Email Hook signing secret (Dashboard → Auth → Hooks).
# Format as shown in the dashboard, e.g. v1,whsec_xxxxxxxxxxxxxxxx
SUPABASE_AUTH_HOOK_SECRET=

# Shared secret used by the Postgres trigger to call /api/send-welcome.
# Must match the value set on the database via:
#   ALTER ROLE service_role SET app.settings.welcome_secret = '...';
INTERNAL_WEBHOOK_SECRET=

# Public site URL. NOTE (9 Aug): transactional email links no longer read this.
# The deployed value was https://app.certify.cx, a host with no working DNS/TLS,
# so every emailed link — "Open dashboard", the welcome mail, the certificate
# mail, referral invites, even the redirect the email-verification link lands on
# — opened a browser security warning. Email links now come from api/_appUrl.js,
# which defaults to the live site. Kept here for the Supabase auth hook URL and
# any tooling that still reads it.
APP_PUBLIC_URL=https://certify.cx

# Optional. Overrides the base URL used for links inside transactional email.
# Leave unset — it defaults to https://certify.cx, the live app. Set it only if
# the app genuinely moves to another hostname (and that hostname serves a valid
# certificate). Do not point it at app.certify.cx; see api/_appUrl.js.
# APP_URL=

# Optional. Absolute URL of the brand mark shown in the header of every
# transactional email. Deliberately NOT derived from APP_PUBLIC_URL — set this
# only if the artwork moves off https://certify.cx/brand-mark.png.
# BRAND_MARK_URL=

# Secret for the daily renewal-reminder cron (vercel.json → crons hits
# GET /api/notify-event). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Set the SAME value in the Vercel project's Environment Variables.
CRON_SECRET=

# WhatsApp notifications (optional — leave blank to disable).
# When these are set, the app also pushes notifications over WhatsApp via
# api/_notifyWhatsApp.js. Defaults target the Meta WhatsApp Cloud API:
#   WHATSAPP_API_URL  = https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages
#   WHATSAPP_API_TOKEN= <permanent access token>
#   WHATSAPP_FROM     = (optional) sender id, only needed by some providers
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=