# Supabase credentials (required)
VITE_SUPABASE_URL=https://jlzzessjfswplcieymki.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Impsenplc3NqZnN3cGxjaWV5bWtpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM1NzQ5NjMsImV4cCI6MjA4OTE1MDk2M30.sSSjDCrYRw0Ut-Tw84fcHFTwgkc3GdoGYR6y1O701cI

# Service role key — NEVER expose in frontend code
# Only use in server-side scripts or Supabase Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Geoapify API Key
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Resend transactional email (used by api/auth-email-hook.js + api/send-welcome.js)
RESEND_API_KEY=re_EToUS1Si_P3wLSMsU68cqqdpFhNswNtGc
RESEND_FROM_EMAIL=CertifyCX <noreply@mail.certify.cx>
# From-address for customer-facing lifecycle emails (payment, application,
# audit, certificate) sent by api/notify-event.js + api/issue-certificate.js.
# Must be a domain verified in Resend. Falls back to RESEND_FROM_EMAIL if unset.
RESEND_SUPPORT_FROM_EMAIL=Certify.cx Support <support@certify.cx>

# Supabase Send Email Hook signing secret (Dashboard → Auth → Hooks).
# Format as shown in the dashboard, e.g. v1,whsec_xxxxxxxxxxxxxxxx
SUPABASE_AUTH_HOOK_SECRET=

# Shared secret used by the Postgres trigger to call /api/send-welcome.
# Must match the value set on the database via:
#   ALTER ROLE service_role SET app.settings.welcome_secret = '...';
INTERNAL_WEBHOOK_SECRET=

# Public site URL (used to build links in transactional emails)
APP_PUBLIC_URL=https://app.certify.cx

# Secret for the daily renewal-reminder cron (vercel.json → crons hits
# GET /api/notify-event). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Set the SAME value in the Vercel project's Environment Variables.
CRON_SECRET=