{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/brand-mark.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notify-event",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/notify-event?job=investor-campaign-draft",
      "schedule": "0 21 * * 0"
    }
  ]
}
